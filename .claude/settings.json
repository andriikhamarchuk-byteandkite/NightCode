{
  "permissions": {
    "allow": [
      "Read",
      "Bash(bun install)",
      "Bash(bun run dev:cli)",
      "Bash(bun run --cwd packages/cli typecheck)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
