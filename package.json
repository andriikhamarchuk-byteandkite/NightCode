{
  "name": "nightcode",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "start": "bun run packages/server/src/index.ts",
    "link:cli": "cd packages/cli && bun link",
    "postinstall": "bun run --cwd packages/database db:generate",
    "typecheck": "tsc --noEmit && bun run --cwd packages/cli typecheck && bun run --cwd packages/server typecheck && bun run --cwd packages/shared typecheck && bun run --cwd packages/database typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3"
  }
}
